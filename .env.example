# Klimmeck Guide — variabili locali dell'app. NON contiene secret reali: copia in .env e riempi.
# L'app non possiede chiavi Twitch: client id e secret vivono solo sul backend (D-26).
#
# Dev bypass (Phase 1 + Phase 11 D-23..D-30): con DEV_AUTH_ENABLED=true l'app usa DevAuthTokenService
# e invia DEV_AUTH_ACCESS_TOKEN come bearer; il backend (con il proprio DEV_AUTH_ENABLED=true, mai in
# produzione) lo risolve all'utente dev. DEV_AUTH_ACCESS_TOKEN deve coincidere col valore del backend
# (minimo 16 caratteri). DEV_AUTH_USER_ID è solo un fallback: l'id reale arriva dalla query `me`.
DEV_AUTH_ENABLED=true
DEV_AUTH_ACCESS_TOKEN=replace-with-the-backend-dev-token
DEV_AUTH_USER_ID=replace-with-backend-user-id
DEV_AUTH_TWITCH_ID=replace-with-twitch-user-id
DEV_AUTH_ROLE=adventurer
# true = l'app parte sul sign-in; "Login con Twitch" entra subito con l'identità dev (D-29).
DEV_AUTH_START_SIGNED_OUT=false
